{
  "name": "@ascariodev/sereno-node",
  "version": "0.1.0",
  "description": "Sereno SDK for Node.js.",
  "license": "MIT",
  "homepage": "https://github.com/ascariodev/sereno-js/tree/main/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascariodev/sereno-js.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/ascariodev/sereno-js/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/esm/express.d.ts",
        "default": "./dist/esm/express.js"
      },
      "require": {
        "types": "./dist/cjs/express.d.ts",
        "default": "./dist/cjs/express.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/esm/nest.d.ts",
        "default": "./dist/esm/nest.js"
      },
      "require": {
        "types": "./dist/cjs/nest.d.ts",
        "default": "./dist/cjs/nest.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.ts",
        "default": "./dist/esm/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/esm/pino.d.ts",
        "default": "./dist/esm/pino.js"
      },
      "require": {
        "types": "./dist/cjs/pino.d.ts",
        "default": "./dist/cjs/pino.js"
      }
    },
    "./winston": {
      "import": {
        "types": "./dist/esm/winston.d.ts",
        "default": "./dist/esm/winston.js"
      },
      "require": {
        "types": "./dist/cjs/winston.d.ts",
        "default": "./dist/cjs/winston.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sereno-node": "./dist/esm/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ascariodev/sereno-core": "^0.1.0"
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/esm/express.d.ts"
      ],
      "nest": [
        "./dist/esm/nest.d.ts"
      ],
      "next": [
        "./dist/esm/next.d.ts"
      ],
      "pino": [
        "./dist/esm/pino.d.ts"
      ],
      "winston": [
        "./dist/esm/winston.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9",
    "express": ">=4",
    "next": ">=15",
    "reflect-metadata": ">=0.1.12",
    "rxjs": ">=7",
    "pino": ">=8",
    "winston": ">=3"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "next": "^16.4.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
