{
  "name": "@ascariodev/sereno-core",
  "version": "0.1.0",
  "description": "Shared core of the Sereno SDKs for Node.js and the browser.",
  "license": "MIT",
  "homepage": "https://github.com/ascariodev/sereno-js/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascariodev/sereno-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ascariodev/sereno-js/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
